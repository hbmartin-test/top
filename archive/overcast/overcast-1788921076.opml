#progressbar #timeelapsed, #progressbar #timeremaining { width: 20%; display: inline-block; font-size: 0.75em; font-variant-numeric: tabular-nums; }
#progressbar #timeremaining { float: right; text-align: right; }
#progressbar #timeelapsed { float: left; }
    body#episode_card #progressbar #timeelapsed { padding-left: 0.25em; }

#progressslidercontainer { position: relative; height: 28px; clear: both; }
#progresssliderbackground, #progressslider { position: absolute; left: 0; width: 100%; margin: 0; }
#progresssliderbackground {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    top: 10px;
    height: 8px;
    z-index: 0;
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    background-color: #ececec;
    color: #fc7e0f;
}
#progresssliderbackground::-webkit-progress-bar { background-color: #ececec; }
#progresssliderbackground::-webkit-progress-value { background-color: #fc7e0f; }
#progresssliderbackground::-moz-progress-bar { background-color: #fc7e0f; }

.progresssliderloadedrange {
    position: absolute;
    top: 10px;
    width: 0;
    height: 8px;
    border-radius: 4px;
    background-color: #fc7e0f;
    opacity: 0.18;
    pointer-events: none;
    z-index: 1;
}

#progressslider {
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    top: 0;
    height: 28px;
    z-index: 2;
    border: 0;
    background-color: transparent;
    touch-action: manipulation;
}
#progressslider:focus { outline: none; }
#progressslider:focus-visible { outline: 2px solid #fc7e0f; outline-offset: 2px; border-radius: 6px; }
#progressslider::-webkit-slider-runnable-track { width: 100%; height: 28px; background-color: transparent; }
#progressslider::-webkit-slider-thumb {
    -webkit-appearance: none;
    margin-top: 6px;
    height: 16px;
    width: 16px;
    border-radius: 50%;
    background: #fc7e0f;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
}
#progressslider::-moz-range-track { width: 100%; height: 28px; background-color: transparent; }
#progressslider::-moz-range-thumb {
    height: 16px;
    width: 16px;
    border-radius: 50%;
    background: #fc7e0f;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
}

.buffering #progresssliderbackground { animation: ocbufferpulse 1.2s ease-in-out infinite; }
@keyframes ocbufferpulse { 50% { opacity: 0.4; } }

/* Compact scrubber inside the embed card */
body#episode_card #progressslidercontainer { height: 18px; }
body#episode_card #progresssliderbackground { top: 5px; }
body#episode_card .progresssliderloadedrange { top: 5px; }
body#episode_card #progressslider { height: 18px; }
body#episode_card #progressslider::-webkit-slider-runnable-track { height: 18px; }
body#episode_card #progressslider::-webkit-slider-thumb { margin-top: 1px; }
