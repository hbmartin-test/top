#playcontrols button {
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
    transition: transform 0.08s ease-out;
}
    #playcontrols button:active { transform: scale(0.92); }
    #playcontrols button:focus-visible { outline: 2px solid #fc7e0f; outline-offset: 4px; border-radius: 8px; }

#seekbackbutton img, #seekforwardbutton img, #playpausebutton img {
    position: absolute; top: 0; left: 0;
    display: block;
    width: 100%; height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
}
    #seekbackbutton img, #seekforwardbutton img { top: 5%; left: 5%; width: 90%; height: 90%; }
    #playpausebutton img { top: 10%; left: 10%; width: 80%; height: 80%; }
    img#playpausebutton_pauseicon { display: none; }

#progressbar { width: 93%; margin: 1.5em auto 0 auto; }
