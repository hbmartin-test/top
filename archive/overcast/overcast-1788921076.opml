    <body>
        <div class="nav">
                        
                                    <a class="left navlink" href="/"><img class="narrow" id="tinyhomeimg" src="/img/logo.svg" alt="Overcast"/><span class="notnarrow">Overcast</span></a>
                    <a class="left navlink" href="/podcasterinfo">Podcaster Info</a>
                    <a class="left navlink" href="/ads">Ads</a>
                    <a class="left navlink" href="/login">Log In</a>
                            
                        <div class="clear"></div>
        </div>

        <div class="container pure-g">
            <div class="content pure-u-1">
                

<div class="pure-g">
    <div class="pure-u-1-4"></div>
    <div class="pure-u-1 pure-u-sm-1-2 pure-form pure-form-stacked">

        

        <h2 class="centertext">Log In</h2>

        <div class="pure-u-1" id="login_container">

                <div id="qrdirectlinkcontainer" class="centertext">
                    <p class="lighttext">
                        Already have the Overcast app?<br/>
                        Scan this QR code with your iPhone camera:
                    </p>
                    <div id="qrcode" data-token="XE4LGH2JBdS4gA5eo4uR" data-then="account"></div>

                    <p class="centertext lighttext">
                        Or, from your iPhone:<br/>
                        <a id="qrdirectlink" data-target-url="overcast:///auth?t=XE4LGH2JBdS4gA5eo4uR&l=browser" href="/main/login_app?t=XE4LGH2JBdS4gA5eo4uR&l=browser">Authenticate with Overcast app</a>
                    </p>
                </div>

                        </div>

        <br/>
        
        <br/><br/>
        <h2 class="centertext marginbottom05">Email-based accounts</h2>
        <p class="lighttext centertext">
            Most Overcast accounts do not have email addresses or passwords.
            If you&rsquo;ve set them:
        </p>


        <form method="post">
            <input type="hidden" name="then" value="account" />
            <label for="email" class="control-label">Email:</label>
            <input class="pure-input-1" tabindex="1" type="email" name="email" id="email" autocomplete="username" value="" placeholder="your@email.com"/>

            <button class="hiddenbutton" aria-hidden="true" type="submit"></button>
            <button class="ocbutton margintop1 right attachsubmit" tabindex="3" type="submit" name="forgot">Forgot?</button>
            <label for="password" class="control-label margintop1 inlineblock">Password:</label>
            <input class="pure-input-1" tabindex="2" id="password" name="password" type="password" autocomplete="current-password"/>

            <div class="centertext margintop1">
                <button class="ocborderedbutton" tabindex="4" type="submit">Log In</button>
            </div>
        </form>
    </div>
    <div class="pure-u-1-4"></div>
</div>
            </div>
        </div>
        
        <div class="footer l-box is-center">
