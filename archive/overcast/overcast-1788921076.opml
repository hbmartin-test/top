#speedcontrols { display: flex; justify-content: center; margin: 2.5em 0 0 0; }

.speedmenu {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: #fc7e0f;
    border: 1px solid #fc7e0f;
    border-radius: 999px;
    padding: 5px 12px 5px 11px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.1s ease-out;
}
    .speedmenu:hover { background-color: rgba(252, 126, 15, 0.08); }
    .speedmenu:focus-within { outline: 2px solid #fc7e0f; outline-offset: 2px; }
    .speedmenu img { display: block; width: 1.3em; height: 1.3em; -webkit-user-drag: none; }
    .speedmenu::after {
        /* disclosure chevron, since the native one is suppressed below */
        content: "";
        position: absolute;
        right: 13px;
        top: 50%;
        width: 0.4em;
        height: 0.4em;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: translateY(-65%) rotate(45deg);
        pointer-events: none;
    }
    .speedmenu select {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        font: inherit;
        font-size: 0.9em;
        font-variant-numeric: tabular-nums;
        color: inherit;
        background: transparent;
        border: 0;
        margin: 0;
        padding: 0 1.4em 0 0;
        cursor: pointer;
        outline: none;
    }
    .speedmenu select::-ms-expand { display: none; }

